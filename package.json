{
  "name": "songyu-studio",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "test:e2e:mock": "playwright test --config playwright.mock.config.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.2.0"
  }
}
